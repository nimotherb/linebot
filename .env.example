# Aiven MySQL 連線字串；正式值只放在 Render Environment，不要提交到 Git。
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl_ca=/path/to/ca.pem

LINE_SECRET_CUSTOMER=
LINE_TOKEN_CUSTOMER=
LINE_SECRET_STAFF=
LINE_TOKEN_STAFF=

# 第一次部署才使用；帳號建立後可從 Render 移除這兩個初始 PIN。
ADMIN_INITIAL_PIN=0206
MANAGER_INITIAL_PIN=1355

# 客戶畫面用流水號；第一筆客戶為 VIP-4800，之後依序增加。
CUSTOMER_SERIAL_START=4800

# 公開師傅照片來源；預設使用同一個 GitHub 專案的 official-website 圖片。
THERAPIST_IMAGE_BASE_URL=https://raw.githubusercontent.com/nimotherb/linebot/main/official-website/public/images/therapists

# 逗號分隔。正式預覽網址與本機開發網址都要列入。
ADMIN_ALLOWED_ORIGINS=https://equalspa.pages.dev,https://equalspa-admin.pages.dev,http://localhost:3000

# LINE Bot 的「後台／排班」與管理員選單連結。
ADMIN_DASHBOARD_URL=https://equalspa-admin.pages.dev/

# 使用 Fernet.generate_key() 產生，遺失後將無法解開員工私密健康資料。
STAFF_HEALTH_ENCRYPTION_KEY=

# 產生給師傅的無登入班表網址時使用。
STAFF_SCHEDULE_BASE_URL=https://equalspa-admin.pages.dev/?staff_token=

# 單一 Render worker、目前流量建議值。總連線上限為 pool_size + max_overflow。
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=3
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_READ_TIMEOUT_SECONDS=20
DATABASE_WRITE_TIMEOUT_SECONDS=20

# 選用的 Aiven keepalive；0 為停用。它不能阻止 Render Free 休眠，因為
# Render 休眠時整個 Python process（包含 keepalive thread）都會停止。
DATABASE_KEEPALIVE_SECONDS=0

# LINE Flex 失敗時給客戶的真人客服連結，以及只提供管理帳號的 Render 紀錄頁。
CUSTOMER_SERVICE_URL=https://lin.ee/vOq3Xvt
RENDER_LOGS_URL=https://dashboard.render.com/web/srv-da059bgjo6nc73doq380/logs
BOOKING_WEB_URL=https://equalspa-admin.pages.dev/booking

# 建立 LINE Login／LIFF 後填入。LIFF ID 可公開；Channel ID 用於後端驗證 ID Token。
LINE_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
