# Aiven MySQL 連線字串；正式值只放在 Render Environment，不要提交到 Git。
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl_ca=/path/to/ca.pem

LINE_SECRET_CUSTOMER=
LINE_TOKEN_CUSTOMER=
LINE_SECRET_STAFF=
LINE_TOKEN_STAFF=

# 第一次部署才使用；帳號建立後可從 Render 移除這兩個初始 PIN。
ADMIN_INITIAL_PIN=
MANAGER_INITIAL_PIN=

# 逗號分隔。正式預覽網址與本機開發網址都要列入。
ADMIN_ALLOWED_ORIGINS=https://equalspa-ops-preview.c83500699.chatgpt.site,http://localhost:3000

# LINE Bot 的「後台／排班」與管理員選單連結。
ADMIN_DASHBOARD_URL=https://equalspa-ops-preview.c83500699.chatgpt.site/

# 使用 Fernet.generate_key() 產生，遺失後將無法解開員工私密健康資料。
STAFF_HEALTH_ENCRYPTION_KEY=

# 產生給師傅的無登入班表網址時使用。
STAFF_SCHEDULE_BASE_URL=https://equalspa-ops-preview.c83500699.chatgpt.site/?staff_token=

# Aiven 極小查詢心跳，預設每 12 分鐘執行一次（秒）。
DATABASE_HEARTBEAT_SECONDS=720

# LINE Flex 失敗時給客戶的真人客服連結，以及只提供管理帳號的 Render 紀錄頁。
CUSTOMER_SERVICE_URL=https://lin.ee/vOq3Xvt
RENDER_LOGS_URL=https://dashboard.render.com/web/srv-da059bgjo6nc73doq380/logs
BOOKING_WEB_URL=https://equalspa-ops-preview.c83500699.chatgpt.site/booking

# 建立 LINE Login／LIFF 後填入。LIFF ID 可公開；Channel ID 用於後端驗證 ID Token。
LINE_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
